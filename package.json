{
  "name": "unihaat-v1",
  "version": "1.1.0",
  "description": "UniHaat — Your Campus. Your Marketplace. Verified hyperlocal student-to-student marketplace.",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 5173 --bind 0.0.0.0",
    "dev:unimail": "node server/unimail.mjs",
    "setup:browser": "node scripts/setup-browser.mjs",
    "setup:assets": "node scripts/make-assets.mjs && node scripts/make-fonts.mjs && node scripts/vendor-supabase.mjs",
    "setup:google": "node scripts/configure-google-auth.mjs",
    "test": "node scripts/setup-browser.mjs && npx playwright test",
    "test:sql": "node scripts/run-sql-suite.mjs",
    "test:db": "node scripts/test-database.mjs",
    "test:engine": "node scripts/engine-check.mjs && node scripts/optimality-check.mjs",
    "test:overflow": "node scripts/overflow-check.mjs",
    "test:probes": "node scripts/migration-probes.mjs --prepare",
    "test:unimail": "node --test tests/unimail.test.mjs",
    "test:dist": "node scripts/build.mjs && BASE_URL=http://localhost:5175 npx playwright test --config=playwright.dist.config.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.2.5",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@playwright/test": "^1.49.0",
    "@sparticuz/chromium": "^153.0.0",
    "pg": "^8.23.1"
  }
}
